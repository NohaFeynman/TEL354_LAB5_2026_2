{# Reglas de {{ inventory_hostname }} generadas desde la intención (connectivity).
   Por cada par (A, B) y cada sentido se instalan dos reglas en los switches
   del camino: IPv4 de A hacia B y ARP de A preguntando/respondiendo a B.
   Sin controlador nadie responde los ARP, por eso también se reenvían.
   ofport traduce el nombre de la interfaz (ens5) a su número OpenFlow. #}
{% for pair in connectivity %}
{%   for src, dst in [(pair[0], pair[1]), (pair[1], pair[0])] %}
{%     set s_src = lab_hosts[src].switch %}
{%     set s_dst = lab_hosts[dst].switch %}
{%     set on_path = inventory_hostname in [s_src, s_dst] or (inventory_hostname == core_switch and s_src != s_dst) %}
{%     if on_path %}
{%       if s_dst == inventory_hostname %}
{%         set out = ports[dst] %}
{%       elif inventory_hostname == core_switch %}
{%         set out = ports[s_dst] %}
{%       else %}
{%         set out = ports.uplink %}
{%       endif %}
cookie=0x354,priority=100,ip,nw_src={{ lab_hosts[src].ip }},nw_dst={{ lab_hosts[dst].ip }} actions=output:{{ ofport[out] }}
cookie=0x354,priority=100,arp,arp_spa={{ lab_hosts[src].ip }},arp_tpa={{ lab_hosts[dst].ip }} actions=output:{{ ofport[out] }}
{%     endif %}
{%   endfor %}
{% endfor %}
